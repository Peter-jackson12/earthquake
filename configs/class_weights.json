{
  "name": "class_weights_v1",
  "seed": 42,
  "metric": "macro_f1",
  "note": "DT/RF balanced and GBC train-fold balanced sample_weight; each differs only in weighting from its recorded unweighted reference. No holdout.",
  "models": {
    "dummy": {
      "strategy": "most_frequent"
    },
    "lr": {
      "solver": "lbfgs",
      "C": 1.0,
      "max_iter": 1500,
      "tol": 0.0001,
      "random_state": 42
    },
    "dt": {
      "max_depth": 12,
      "min_samples_leaf": 5,
      "random_state": 42,
      "class_weight": "balanced"
    },
    "rf": {
      "n_estimators": 100,
      "max_depth": 20,
      "min_samples_leaf": 2,
      "max_features": 0.1,
      "random_state": 42,
      "class_weight": "balanced"
    },
    "gbc": {
      "n_estimators": 100,
      "learning_rate": 0.1,
      "max_depth": 3,
      "max_features": null,
      "random_state": 42
    }
  },
  "sample_weight": {
    "gbc": "balanced"
  }
}
