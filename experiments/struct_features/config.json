{
 "study_id": "T12_struct_features_v1",
 "branch": "peter-exp/struct-features-v1",
 "base_commit": "7956901",
 "single_factor": "appending region-free structure-derived features (bundle S, D or SD) to each family's existing matrix; original 38 inputs and C age policy unchanged",
 "bundles": {
  "S": {
   "features": [
    "n_super",
    "n_weak",
    "n_strong",
    "n_use"
   ],
   "formulas": {
    "n_super": "sum of the 11 has_superstructure_* flags",
    "n_weak": "adobe_mud+mud_mortar_stone+stone_flag+mud_mortar_brick+timber+bamboo",
    "n_strong": "cement_mortar_stone+cement_mortar_brick+rc_non_engineered+rc_engineered",
    "n_use": "sum of the 10 specific has_secondary_use_* flags (agriculture, hotel, rental, institution, school, industry, health_post, gov_office, use_police, other); EXCLUDES the aggregate has_secondary_use"
   }
  },
  "D": {
   "features": [
    "height_per_floor",
    "area_x_floors",
    "families_per_floor"
   ],
   "formulas": {
    "height_per_floor": "height_percentage / max(count_floors_pre_eq, 1)",
    "area_x_floors": "area_percentage * count_floors_pre_eq",
    "families_per_floor": "count_families / max(count_floors_pre_eq, 1)"
   }
  },
  "SD": {
   "features": [
    "n_super",
    "n_weak",
    "n_strong",
    "n_use",
    "height_per_floor",
    "area_x_floors",
    "families_per_floor"
   ]
  }
 },
 "excluded_features": "age and any age-derived feature; any geo-derived feature; T3 features age_band, geo_foundation, geo_age, foundation_age",
 "derived_scaling": "StandardScaler fit on the training fold, then float32 cast; same for both families; appended AFTER the existing columns (CSR hstack by ColumnTransformer, one-hot block never densified)",
